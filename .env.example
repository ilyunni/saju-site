# 이 파일을 복사해서 .env로 저장하고 실제 값을 채워넣으세요.
# .env 파일 자체는 git에 올리지 않습니다 (.gitignore에 포함됨).

# Anthropic Console(platform.claude.com)에서 발급받은 API 키
ANTHROPIC_API_KEY=

# 사용할 모델 (비워두면 기본값 claude-haiku-4-5 사용, 비용 절감용)
# 품질을 높이고 싶으면 claude-sonnet-5 로 바꿔도 됩니다.
ANTHROPIC_MODEL=claude-haiku-4-5

# Google Cloud Console에서 발급받은 OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=

# 세션 쿠키(JWT) 서명에 쓰는 임의의 긴 무작위 문자열 (아무거나 길게 만들면 됨)
JWT_SECRET=

# Neon(또는 다른 Postgres) 연결 문자열
# 예: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# 계정당 하루 무료 사용 횟수
DAILY_FREE_LIMIT=3

# 로컬 개발이면 development, 실제 배포면 production
NODE_ENV=development

PORT=3000
